{
  "name": "streaming-bff",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.33.3",
  "scripts": {
    "gen:types": "graphql-codegen --config codegen.ts",
    "gen:schema": "tsx scripts/print-schema.ts",
    "gen:supergraph": "tsx scripts/compose-supergraph.ts",
    "gen": "pnpm gen:types && pnpm gen:schema && pnpm gen:supergraph",
    "typecheck": "tsc -p tsconfig.json",
    "test": "node --import tsx --test \"packages/*/src/**/*.test.ts\"",
    "start:bff": "tsx apps/bff/src/main.ts",
    "start:catalog-subgraph": "tsx apps/catalog-subgraph/src/main.ts",
    "start:availability-subgraph": "tsx apps/availability-subgraph/src/main.ts",
    "start:mocks": "tsx apps/mock-backends/src/main.ts",
    "smoke": "tsx scripts/smoke-test.ts"
  },
  "dependencies": {
    "@apollo/subgraph": "^2.15.1",
    "@envelop/core": "^5.6.1",
    "@graphql-tools/load-files": "^7.0.1",
    "@graphql-tools/merge": "^9.2.8",
    "@graphql-tools/schema": "^10.1.5",
    "@graphql-yoga/plugin-persisted-operations": "^3.24.6",
    "dataloader": "^2.2.3",
    "graphql": "^16.14.2",
    "graphql-yoga": "^5.24.6",
    "lru-cache": "^11.5.3"
  },
  "devDependencies": {
    "@apollo/composition": "^2.14.4",
    "@biomejs/biome": "^2.5.15",
    "@graphql-codegen/cli": "^7.4.6",
    "@graphql-codegen/typescript": "^6.1.2",
    "@graphql-codegen/typescript-operations": "^6.1.10",
    "@graphql-codegen/typescript-resolvers": "^6.1.1",
    "@graphql-tools/utils": "^12.1.0",
    "@types/node": "^24.0.0",
    "nx": "^23.3.0",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3"
  }
}
