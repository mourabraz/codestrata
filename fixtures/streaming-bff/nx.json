{
  "$schema": "./node_modules/nx/schemas/nx-schema.json",
  "neverConnectToCloud": true,
  "namedInputs": {
    "default": ["{projectRoot}/**/*"],
    "production": ["default", "!{projectRoot}/**/*.test.ts"]
  },
  "targetDefaults": {
    "typecheck": {
      "cache": true,
      "inputs": ["production", "^production"]
    },
    "test": {
      "cache": true
    }
  }
}
